# Required
GEMINI_API_KEY=your-gemini-api-key

# Qdrant (local docker-compose defaults)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=notebooklm

# Qdrant Cloud (uncomment + fill for cloud deploy)
# QDRANT_HOST=xxxxxxxx.gcp.cloud.qdrant.io
# QDRANT_PORT=6334
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_USE_TLS=true

# SQLite
DB_PATH=./notebooklm.db

# Server
PORT=8080

# RAG tuning
EMBED_WORKERS=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_HISTORY_TURNS=10

# File uploads
UPLOAD_DIR=/tmp/notebooklm_uploads
