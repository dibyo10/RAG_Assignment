# Required
OPENAI_API_KEY=sk-...

# Qdrant (defaults work with docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=notebooklm

# SQLite
DB_PATH=./notebooklm.db

# Server
PORT=8080

# RAG tuning
EMBED_WORKERS=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MAX_HISTORY_TURNS=10

# File uploads
UPLOAD_DIR=/tmp/notebooklm_uploads
